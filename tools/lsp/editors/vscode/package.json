{
  "name": "biwa-lang",
  "displayName": "Biwa Language",
  "description": "Syntax highlighting and language support for the Biwa novel game language",
  "version": "0.1.0",
  "publisher": "biwa",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/biwa-engine/biwa-lsp"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "biwa",
        "aliases": [
          "Biwa",
          "biwa"
        ],
        "extensions": [
          ".biwa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "biwa",
        "scopeName": "source.biwa",
        "path": "./syntaxes/biwa.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "biwa",
        "scopes": {
          "keyword": [
            "keyword.control.biwa",
            "keyword.declaration.biwa",
            "keyword.other.biwa"
          ],
          "type": [
            "entity.name.type.biwa",
            "support.type.primitive.biwa"
          ],
          "function": [
            "entity.name.function.biwa"
          ],
          "variable": [
            "entity.name.variable.biwa",
            "variable.other.readwrite.biwa"
          ],
          "parameter": [
            "variable.parameter.biwa"
          ],
          "property": [
            "variable.other.property.biwa"
          ],
          "number": [
            "constant.numeric.integer.biwa"
          ],
          "string": [
            "string.quoted.double.biwa"
          ],
          "comment": [
            "comment.line.double-slash.biwa"
          ],
          "operator": [
            "keyword.operator.biwa"
          ],
          "namespace": [
            "entity.name.namespace.biwa"
          ],
          "method": [
            "entity.name.function.member.biwa"
          ],
          "interface": [
            "entity.name.type.interface.biwa"
          ],
          "novelText": [
            "text.raw.novel.biwa"
          ],
          "novelCommand": [
            "keyword.control.command.biwa"
          ],
          "novelCharacter": [
            "entity.name.tag.character.biwa"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/msal-node": "^3.5.3",
      "cheerio": "1.0.0"
    }
  }
}
