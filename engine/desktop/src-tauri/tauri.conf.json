{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "biwa-game",
  "version": "0.1.0",
  "identifier": "dev.biwa.game",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
