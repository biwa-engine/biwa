struct Color {
  // 現在のBiwaにはByte型がないのでUintで表現しているが、
  // いずれも 0 ~ 255 の値に丸められる
  r: Uint,
  g: Uint,
  b: Uint,
  a: Uint,
}

impl Color {
  fn red() -> Self {
    Self {
      r = 255,
      g = 0,
      b = 0,
      a = 255,
    }
  }
  
  fn green() -> Self {
    Self {
      r = 0,
      g = 255,
      b = 0,
      a = 255,
    }
  }
  
  fn blue() -> Self {
    Self {
      r = 0,
      g = 0,
      b = 255,
      a = 255,
    }
  }
}
