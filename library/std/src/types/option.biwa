// Option[T] 型
// 将来的にはenumで実装する

[[native(arch="typescript")]]
type Option[T] = {{
  T | null
}};

// wasm では null 可能な anyref にする。null が none である。
//
// これは enum が入るまでの暫定である。
// anyref に入れられるのは WasmGC の参照型だけなので、
// Option[Int] や Option[String] (externref は別の型階層) は
// バックエンドがエラーにする。
[[native(arch="wasm")]]
type Option[T] = {{
  anyref
}};

impl[T] Option[T] {
  [[native(arch="typescript")]]
  fn none() -> Self {{
    return null;
  }}

  [[native(arch="wasm")]]
  fn none() -> Self {{
    ref.null any
  }}

  // 値そのものが Option の表現なので、包む操作は何もしない。
  [[native(arch="typescript")]]
  fn some(value: T) -> Self {{
    return value;
  }}

  [[native(arch="wasm")]]
  fn some(value: T) -> Self {{
    local.get 0
  }}

  [[native(arch="typescript")]]
  fn is_some(self) -> Bool {{
    return self !== null;
  }}

  [[native(arch="wasm")]]
  fn is_some(self) -> Bool {{
    local.get 0
    ref.is_null
    i32.eqz
  }}

  [[native(arch="typescript")]]
  fn is_none(self) -> Bool {{
    return self === null;
  }}

  [[native(arch="wasm")]]
  fn is_none(self) -> Bool {{
    local.get 0
    ref.is_null
  }}

  // 中身を取り出す。none なら失敗する。
  //
  // wasm では Option[T] が anyref なので、T へ落とすのに `ref.cast` が要る。
  // 型は単相化ごとに違うので、`%ret%` (この関数の戻り値の型) を
  // コンパイラに埋めてもらっている。
  [[native(arch="typescript")]]
  fn unwrap(self) -> T {{
    if (self === null) {
      throw new Error("[biwa] Option::unwrap() on a none value");
    }
    return self;
  }}

  [[native(arch="wasm")]]
  fn unwrap(self) -> T {{
    local.get 0
    ref.cast %ret%
  }}
}
