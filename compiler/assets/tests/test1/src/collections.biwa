[[native(arch="typescript")]]
pub type Vec[T] = {{
  Array<T>
}};

[[native(arch="wasm")]]
pub type Vec[T] = {{
  externref
}};

impl[T] Vec[T] {
  [[native(arch="typescript")]]
  pub fn push(self, v: T) {{
    self.push(v);
    return;
  }}

  [[native(arch="wasm")]]
  pub fn push(self, v: T) {{
    ;; TODO: エンジン側の Vec API に繋ぐ
  }}

  [[native(arch="typescript")]]
  pub fn new() -> Self {{
    return [];
  }}

  [[native(arch="wasm")]]
  pub fn new() -> Self {{
    ;; TODO: エンジン側の Vec API に繋ぐ
    ref.null extern
  }}
}

pub struct Pair[T, U] {
  pub x: T,
  pub y: U,
}

impl[T, U] Pair[T, U] {
  pub fn new(x: T, y: U) -> Self {
    Self {
      x = x,
      y = y,
    }
  }
  
  pub fn x(self) -> T {
    self.x
  }

  pub fn y(self) -> U {
    self.y
  }
}

impl Pair[Int, Int] {
  pub fn add(self) -> Int {
    self.x + self.y
  }
}

impl Pair[Float, Float] {
  pub fn add(self) -> Float {
    self.x + self.y
  }
}

impl[T] Pair[T, Int] {
  pub fn y_int(self) -> Int {
    self.y
  }
}
