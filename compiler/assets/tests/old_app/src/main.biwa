// 旧い契約 `fn app() -> Window` のままの playable package。
//
// `Window[S]` は状態の型 `S` を持つので、ランタイムには受け取れない。
// `app` は戻り値を持たず、中で `show()` する契約になった (biwac_scene が検査する)。
//
// 本体は型としては正しい。ビルドが失敗する理由が契約違反だけになるようにするためである。

import std::game::Game;
import std::game::config::Config;
import std::game::window::GameWindow;
import std::game::window::Window;

struct MyGameState {}

type MyGame = Game[MyGameState];

fn app() -> Window[MyGameState] {
  Window::new(main)
}

fn on_new_game(window: GameWindow) -> MyGame {
  Game::new(window, "old_app", MyGameState {}, Config::default())
}

scene main(g: MyGame) -> MyGame {{
  Hello.

  #endscene g
}}
