pub struct Color {
  // 現在のBiwaにはByte型がないのでUintで表現しているが、
  // いずれも 0 ~ 255 の値に丸められる
  pub r: Uint,
  pub g: Uint,
  pub b: Uint,
  pub a: Uint,
}

impl Color {
  pub fn new(r: Uint, g: Uint, b: Uint, a: Uint) -> Self {
    Self { r = r, g = g, b = b, a = a }
  }

  pub fn white() -> Self {
    Self {
      r = 255,
      g = 255,
      b = 255,
      a = 255,
    }
  }

  pub fn black() -> Self {
    Self {
      r = 0,
      g = 0,
      b = 0,
      a = 255,
    }
  }

  pub fn red() -> Self {
    Self {
      r = 255,
      g = 0,
      b = 0,
      a = 255,
    }
  }
  
  pub fn green() -> Self {
    Self {
      r = 0,
      g = 255,
      b = 0,
      a = 255,
    }
  }
  
  pub fn blue() -> Self {
    Self {
      r = 0,
      g = 0,
      b = 255,
      a = 255,
    }
  }
}
