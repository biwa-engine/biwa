// もっともプリミティブなAPIを提供する
// 描画の単位はピクセル

import package::string::String;
import package::game::Scene;
import package::option::Option;
import package::game::font::Font;
import package::game::image::Image;
import package::game::color::Color;
import package::game::font::TextWeight;
import package::game::base_engine::sys_content_push_text;
import package::game::base_engine::sys_content_flush;
import package::game::base_engine::sys_content_clear;
import package::game::base_engine::wait;

// ゲームの出力先の束。本物の std ではランタイムが組み立てて `SceneStartButton` の `on_click(window)` に渡す。
//
// フィクスチャ版は出力先の ui_id を持たない
// (本物の std (`library/std`) は canvas / message area の ui_id を持つ)。
// コンパイラの検査 (host export など) に要る形だけを揃えている。
pub struct GameWindow {
  pub canvas: Canvas,
  pub message_window: MessageWindow,
}

// ランタイムが `GameWindow` を組み立てるための入口。
//
// 本物の std では ui_id を受け取り、0 を「無し」として `GameWindow::new` に渡す。
// フィクスチャ版は ui_id を持たないので受け取るだけで使わない。
[[host_export="__biwa_std_game_window_new"]]
pub fn game_window_new_for_host(canvas_id: Uint, message_area_id: Uint) -> GameWindow {
  GameWindow::new()
}

// UI の root Element。ゲーム側の `fn main()` が組み立てて `show()` する。
//
// フィクスチャ版は Page を持たない (本物の std (`library/std`) は Page を持ち、
// `show()` で UI syscall を発行する)。コンパイラの検査 (`main` のシグニチャ、
// 関数の値) に要る形だけを揃えている。本物と同じく、scene 本体は `new` で必ず受け取る。
[[lang="ui_window"]]
pub struct Window[S] {
  pub main_scene: Scene[S],
}

impl[S] Window[S] {
  pub fn new(main_scene: Scene[S]) -> Self {
    Window { main_scene = main_scene }
  }

  // 本物の std では UI syscall を発行し、`main_scene` をホストに預ける。
  pub fn show(self) {}
}

impl GameWindow {
  pub fn new() -> Self {
    Self {
      canvas = Canvas{},
      message_window = MessageWindow{},
    }
  }

  // クリックが来るまでシーンを止める。
  pub fn wait(self) {
    wait();
  }

  // fn width(self) -> Uint;
  // fn height(self) -> Uint;
}

pub struct Canvas {}

impl Canvas {
  // fn create_image(self, image: Image, x: Int, y: Int, width: Option[Uint], height: Option[Uint]);
}

pub struct MessageWindow {}

impl MessageWindow {
  // テキストを 1 つ積む。まだ描画されない。
  //
  // 引数はすべて**解決済みの絶対値**である。設定を読んで
  // ここに渡す形にするのは `std::game::content` の仕事で、
  // Window API は設定を知らない。
  //
  // `Size` は enum なので、syscall には (単位, 値) の 2 つに割って渡す。
  pub fn push_text(self, text: String, speed: Float, size: Size, weight: TextWeight, color: Color) {
    match size {
      Size::Vw(v) => {
        sys_content_push_text(
          text, speed, 0, v, weight.weight, color.r, color.g, color.b, color.a);
      }
      Size::Vh(v) => {
        sys_content_push_text(
          text, speed, 1, v, weight.weight, color.r, color.g, color.b, color.a);
      }
    }
  }

  // 積まれたものをまとめて出し始める。
  pub fn flush(self) {
    sys_content_flush();
  }

  // 枠を空にする。呼ぶ時機を決めるのは std であってエンジンではない。
  pub fn clear(self) {
    sys_content_clear();
  }

  // fn set_talker_name(self, name: String);
  // fn set_talker_image(self, image: Image);
}

pub struct Position {
  pub x: Int,
  pub y: Int,
}

pub enum Size {
  // All of these `Float` value must be positive.
  Vw(Float), // 100.0 means 100 % of viewport width.
  Vh(Float), // 100.0 means 100 % of viewport height.
  
  // vw, vh との相互変換が難しいため保留
  // エンジン側に処理させる必要があるかもしれない
  // Px(Float),
}

impl Size {
  pub fn mul(self, mul: Float) -> Self {
    match self {
      Size::Vw(vw) => Size::Vw(vw * mul),
      Size::Vh(vh) => Size::Vh(vh * mul),
      // Size::Px(px) => Size::Px(px * mul),
    }
  }
}
