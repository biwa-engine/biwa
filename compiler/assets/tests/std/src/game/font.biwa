import package::string::String;

pub struct Font {
  pub path: String,
}

impl Font {
  pub fn new(path: String) -> Self {
    Self { path = path }
  }
}

pub struct TextWeight {
  pub weight: Uint, // such as 100, 300, 400, 500, 700, ...
}

impl TextWeight {
  pub fn thin() -> Self {
    Self { weight = 100 }
  }
  
  pub fn extra_light() -> Self {
    Self { weight = 200 }
  }
  
  pub fn light() -> Self {
    Self { weight = 300 }
  }
  
  pub fn normal() -> Self {
    Self { weight = 400 }
  }
  
  pub fn medium() -> Self {
    Self { weight = 500 }
  }
  
  pub fn semi_bold() -> Self {
    Self { weight = 600 }
  }
  
  pub fn bold() -> Self {
    Self { weight = 700 }
  }
  
  pub fn extra_bold() -> Self {
    Self { weight = 800 }
  }
  
  pub fn heavy() -> Self {
    Self { weight = 900 }
  }
}
