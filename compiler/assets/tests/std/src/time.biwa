pub struct Duration {
  pub ms: Uint,
}

impl Duration {
  pub fn ms(ms: Uint) -> Self {
    Self { ms = ms }
  }
  
  pub fn sec(sec: Uint) -> Self {
    Self { ms = sec * 1000 }
  }
  
  pub fn min(min: Uint) -> Self {
    Self { ms = min * 60 * 1000 }
  }

  pub fn as_ms(self) -> Uint {
    self.ms
  }

  // trait が導入されたら + のオーバーロードにする
  pub fn add(self, rhs: Duration) -> Self {
    Self { ms = self.ms + rhs.ms }
  }
}
