// 旧い契約 `fn on_new_game() -> Game[..]` のままの playable package。
//
// ランタイムは `on_new_game` に `GameWindow` を渡すので、引数を取らない
// `on_new_game` はシグニチャ検査 (biwac_scene) で拒否されなければならない。
//
// 本体は型としては正しい (ホスト向けの入口で `GameWindow` を作っている)。
// ビルドが失敗する理由が契約違反だけになるようにするためである。

import std::game::Game;
import std::game::config::Config;
import std::game::window::game_window_new_for_host;
import std::game::window::Window;

struct MyGameState {}

type MyGame = Game[MyGameState];

fn app() -> Window {
  Window::new()
}

fn on_new_game() -> MyGame {
  Game::new(
    game_window_new_for_host(0, 0),
    "old_on_new_game",
    MyGameState {},
    Config::default(),
  )
}

scene main(g: MyGame) -> MyGame {{
  Hello.

  #endscene g
}}
