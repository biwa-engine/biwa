import super::from_a;
import super::super::Pair;

// `super::` は親モジュール、`super::super::` はその親 (ここではルート) を指す。
pub fn from_b() -> Int {
  from_a() + super::from_a() + super::super::top() + Pair::new(1, 2).sum()
}

// `Pair` は pub(package) なので、それを返す関数も pub(package) 以下でなければならない。
pub(package) fn make() -> super::super::Pair {
  Pair::new(0, 0)
}
