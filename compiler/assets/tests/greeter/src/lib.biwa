// 依存パッケージの型を公開 API に露出させるライブラリ。
//
// 意図: シグニチャや struct メンバに *依存パッケージで定義された型* が現れたとき、
// .biwameta がそれを外部シンボル参照 (DiskTyKind::ExternalDefined) として書き出し、
// 依存元がそれを復元できることを確認する。
// 以前は自パッケージのシンボル表しか引けず、外部の型は黙ってシンボル 0 番に化けていた。

// 引数も戻り値も std で定義された型。
pub fn greet(name: std::string::String) -> std::string::String {
  return name.concat("!");
}

// struct のメンバが依存パッケージの型。
pub struct Greeting {
  pub message: std::string::String,
}

impl Greeting {
  pub fn new(message: std::string::String) -> Self {
    Self {
      message = message,
    }
  }

  pub fn message(self) -> std::string::String {
    self.message
  }
}

// 戻り値が color の型。
// greeter を使う側から見ると、color は推移的な依存になる。
pub fn theme() -> color::Rgb {
  return color::Rgb::white();
}

// ジェネリックな型。
//
// 使う側は `type IntBox = greeter::Box[Int];` のようにエイリアスを張り、
// そのエイリアス越しに `IntBox::new(1)` と関連関数を引けなければならない。
// エイリアスの右辺が外部パッケージの型を指す場合、canonical な型は
// 使う側の名前ツリーに居ないので、依存メタデータまで降りる必要がある。
pub struct Box[T] {
  pub value: T,
}

impl[T] Box[T] {
  pub fn new(value: T) -> Self {
    Self {
      value = value,
    }
  }

  pub fn get(self) -> T {
    self.value
  }
}

// 型の振る舞いを表す trait。
//
// 使う側 (test1) がこの trait を import して
// 自分の型に実装できることを確認する。
// trait 自身がこのパッケージのものなので、孤児則は満たされる。
pub trait Describe {
  fn describe(self) -> Int;

  fn from_code(code: Int) -> Self;
}

// 自パッケージの trait を自パッケージの型に実装する。
impl Greeting: Describe {
  fn describe(self) -> Int {
    return 1;
  }

  fn from_code(code: Int) -> Self {
    return Greeting::new(greet("code"));
  }
}

// パッケージをまたぐ `[[host_export="..."]]` の検証用。
//
// greeter 自身は playable ではないので成果物を持たない。
// これを使う側 (test1) のビルドで、`.biwameta` のフラグを通じて
// test1 の生成物から export されることを確かめる。
// test1 はどこからもこれを呼ばないので、export に現れることが
// 依存由来の host export も単相化の roots に入っている証拠になる。
// 呼び先の `host_export_helper` も到達性で消されてはならない。
[[host_export="greeter_host_export_demo"]]
pub fn greeter_host_export_demo() -> Int {
  host_export_helper(40)
}

pub fn host_export_helper(x: Int) -> Int {
  x + 2
}
