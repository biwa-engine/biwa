// `fn app()` を持たない playable package。
//
// ランタイムは起動時にまず `app()` を呼んで UI を表示するので、
// playable package は `app` を定義しなければならない (biwac_scene が検査する)。
// それ以外 (`on_new_game(window)` と `scene main`) は正しい形にしてあり、
// ビルドが失敗する理由が `app` の欠落だけになるようにしている。

import std::game::Game;
import std::game::config::Config;
import std::game::window::GameWindow;

struct MyGameState {}

type MyGame = Game[MyGameState];

fn on_new_game(window: GameWindow) -> MyGame {
  Game::new(window, "missing_app", MyGameState {}, Config::default())
}

scene main(g: MyGame) -> MyGame {{
  Hello.

  #endscene g
}}
